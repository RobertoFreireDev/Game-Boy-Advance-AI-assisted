{
  "id": "hud_victory",
  "kind": "object",
  "type": "hud",
  "name": "Victory text",
  "notes": "YOU SURVIVED! with the final time, level and kills, then this monster's best time: NEW BEST TIME! <time> when this run set it, BEST TIME <time> otherwise. Under it NEW MONSTER: <name> when this win unlocked one ('new_mon' is -1 when nothing was unlocked, so the line stays empty).",
  "font": "font_default",
  "elements": [
    {
      "kind": "text",
      "x": 120,
      "y": 8,
      "text": "YOU SURVIVED!",
      "align": "center"
    },
    {
      "kind": "text",
      "x": 120,
      "y": 104,
      "text": "TIME {time_min:02}:{time_sec:02}",
      "align": "center"
    },
    {
      "kind": "text",
      "x": 120,
      "y": 112,
      "text": "LEVEL {level}   KILLS {kills}/25",
      "align": "center"
    },
    {
      "kind": "text",
      "x": 120,
      "y": 120,
      "text": "{new_best|BEST TIME|NEW BEST TIME!} {best_time[chosen]:time}",
      "align": "center"
    },
    {
      "kind": "text",
      "x": 120,
      "y": 136,
      "text": "{new_mon||NEW MONSTER: }{new_mon.name}",
      "align": "center"
    },
    {
      "kind": "text",
      "x": 120,
      "y": 152,
      "text": "PRESS START",
      "align": "center",
      "blink": 30
    }
  ]
}
