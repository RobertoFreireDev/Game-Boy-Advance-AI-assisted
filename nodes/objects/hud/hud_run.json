{
  "id": "hud_run",
  "kind": "object",
  "type": "hud",
  "name": "Run HUD",
  "notes": "Always on screen during a run. Top row: the XP bar (fills toward the next level). Second row: hearts (full ones = health left, dark ones = empty slots up to the maximum), the clock (mm:ss), the level. Third row: monsters defeated and gold found this run.",
  "font": "font_default",
  "elements": [
    {
      "kind": "bar",
      "x": 0,
      "y": 0,
      "var": "xp_pct",
      "max": 100,
      "length": 30,
      "color": 6,
      "back": 13
    },
    {
      "kind": "icon_repeat",
      "x": 8,
      "y": 8,
      "icon": "icon_heart",
      "empty_icon": "icon_heart_empty",
      "var": "health",
      "max_var": "max_health",
      "max": 11
    },
    {"kind": "text", "x": 104, "y": 8, "text": "{time_min:02}:{time_sec:02}"},
    {"kind": "text", "x": 200, "y": 8, "text": "LV{level}"},
    {"kind": "icon", "x": 8, "y": 16, "icon": "icon_skull"},
    {"kind": "text", "x": 16, "y": 16, "text": "{kills}"},
    {"kind": "icon", "x": 192, "y": 16, "icon": "icon_coin"},
    {"kind": "text", "x": 200, "y": 16, "text": "{run_gold}"}
  ],
  "children": ["icon_skull", "icon_heart_empty"]
}
