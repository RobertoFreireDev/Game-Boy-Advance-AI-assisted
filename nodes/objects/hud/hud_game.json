{
  "id": "hud_game",
  "kind": "object",
  "type": "hud",
  "name": "Adventure HUD",
  "notes": "Always on screen while exploring: 5 hearts (top-left) from 'health', gems and keys (top-right).",
  "children": ["icon_gem", "icon_key", "icon_heart", "icon_heart_empty"],
  "font": "font_default",
  "elements": [
    {
      "kind": "icon_repeat",
      "x": 8,
      "y": 8,
      "icon": "icon_heart",
      "empty_icon": "icon_heart_empty",
      "var": "health",
      "max": 5
    },
    {"kind": "icon", "x": 160, "y": 8, "icon": "icon_gem"},
    {"kind": "text", "x": 168, "y": 8, "text": "x{gems}"},
    {"kind": "icon", "x": 200, "y": 8, "icon": "icon_key"},
    {"kind": "text", "x": 208, "y": 8, "text": "x{keys}"}
  ]
}
