{
  "id": "menu_shop",
  "kind": "object",
  "type": "menu",
  "name": "Power-up shop",
  "notes": "Permanent upgrades bought with banked gold (3 ranks each, saved to the cartridge). MIGHT +10% damage, HASTE 8% faster attacks, SPEED +10% walking speed, MAGNET longer pickup reach, VITALITY +1 heart. Each run starts with these bonuses. A buzz means it is maxed out or you need more gold. B or BACK returns to the title.",
  "font": "font_default",
  "title": "POWER UPS",
  "cursor": "icon_cursor",
  "box": {"x": 8, "y": 24, "w": 224, "h": 128, "paper": 3, "border": 2},
  "layout": {"x": 32, "y": 56, "spacing": 16, "title_y": 32},
  "options": [
    {
      "label": "MIGHT      {pu_might}/3   60G",
      "actions": [
        {
          "do": "if_var",
          "var": "pu_might",
          "op": ">=",
          "value": 3,
          "then": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}],
          "else": [
            {
              "do": "if_var",
              "var": "gold",
              "op": ">=",
              "value": 60,
              "then": [
                {"do": "add_var", "var": "gold", "value": -60},
                {"do": "add_var", "var": "pu_might", "value": 1},
                {"do": "save_game"},
                {"do": "play_sfx", "sfx": "sfx_buy"},
                {"do": "open_menu", "menu": "menu_shop"}
              ],
              "else": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}]
            }
          ]
        }
      ]
    },
    {
      "label": "HASTE      {pu_haste}/3   60G",
      "actions": [
        {
          "do": "if_var",
          "var": "pu_haste",
          "op": ">=",
          "value": 3,
          "then": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}],
          "else": [
            {
              "do": "if_var",
              "var": "gold",
              "op": ">=",
              "value": 60,
              "then": [
                {"do": "add_var", "var": "gold", "value": -60},
                {"do": "add_var", "var": "pu_haste", "value": 1},
                {"do": "save_game"},
                {"do": "play_sfx", "sfx": "sfx_buy"},
                {"do": "open_menu", "menu": "menu_shop"}
              ],
              "else": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}]
            }
          ]
        }
      ]
    },
    {
      "label": "SPEED      {pu_speed}/3   40G",
      "actions": [
        {
          "do": "if_var",
          "var": "pu_speed",
          "op": ">=",
          "value": 3,
          "then": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}],
          "else": [
            {
              "do": "if_var",
              "var": "gold",
              "op": ">=",
              "value": 40,
              "then": [
                {"do": "add_var", "var": "gold", "value": -40},
                {"do": "add_var", "var": "pu_speed", "value": 1},
                {"do": "save_game"},
                {"do": "play_sfx", "sfx": "sfx_buy"},
                {"do": "open_menu", "menu": "menu_shop"}
              ],
              "else": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}]
            }
          ]
        }
      ]
    },
    {
      "label": "MAGNET     {pu_magnet}/3   30G",
      "actions": [
        {
          "do": "if_var",
          "var": "pu_magnet",
          "op": ">=",
          "value": 3,
          "then": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}],
          "else": [
            {
              "do": "if_var",
              "var": "gold",
              "op": ">=",
              "value": 30,
              "then": [
                {"do": "add_var", "var": "gold", "value": -30},
                {"do": "add_var", "var": "pu_magnet", "value": 1},
                {"do": "save_game"},
                {"do": "play_sfx", "sfx": "sfx_buy"},
                {"do": "open_menu", "menu": "menu_shop"}
              ],
              "else": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}]
            }
          ]
        }
      ]
    },
    {
      "label": "VITALITY   {pu_health}/3  100G",
      "actions": [
        {
          "do": "if_var",
          "var": "pu_health",
          "op": ">=",
          "value": 3,
          "then": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}],
          "else": [
            {
              "do": "if_var",
              "var": "gold",
              "op": ">=",
              "value": 100,
              "then": [
                {"do": "add_var", "var": "gold", "value": -100},
                {"do": "add_var", "var": "pu_health", "value": 1},
                {"do": "save_game"},
                {"do": "play_sfx", "sfx": "sfx_buy"},
                {"do": "open_menu", "menu": "menu_shop"}
              ],
              "else": [{"do": "play_sfx", "sfx": "sfx_deny"}, {"do": "open_menu", "menu": "menu_shop"}]
            }
          ]
        }
      ]
    },
    {
      "label": "BACK",
      "actions": [{"do": "fade_out", "ticks": 20}, {"do": "goto_scene", "scene": "scn_title"}]
    }
  ],
  "on_cancel": [{"do": "fade_out", "ticks": 20}, {"do": "goto_scene", "scene": "scn_title"}],
  "sounds": {"move": "sfx_select", "select": "sfx_confirm"}
}
