{
  "id": "menu_clear_save",
  "kind": "object",
  "type": "menu",
  "name": "Clear saved progress",
  "notes": "Opens with SELECT on the menu screen. Asks before wiping the saved progress; the cursor starts on NO so it is never cleared by accident. YES locks every monster again except the first three (Furrbit, Emberpup, Splashell), erases every best time (classic and waves; so the waves mode is locked again too), makes every shiny monster plain again and forgets the runs counted toward the next one, drops the 3 items waiting for the next run, selects Furrbit's classic entry and saves that. NO, B or START close it and keep everything.",
  "font": "font_default",
  "title": "CLEAR SAVED PROGRESS?",
  "cursor": "icon_cursor",
  "box": {
    "x": 8,
    "y": 40,
    "w": 224,
    "h": 88,
    "paper": 3,
    "border": 2
  },
  "texts": [
    {
      "x": 24,
      "y": 64,
      "text": "ALL BUT THE FIRST THREE"
    },
    {
      "x": 24,
      "y": 72,
      "text": "MONSTERS LOCKED AGAIN,"
    },
    {
      "x": 24,
      "y": 80,
      "text": "BEST TIMES, SHINIES GONE."
    }
  ],
  "layout": {
    "x": 104,
    "y": 96,
    "spacing": 16,
    "title_y": 48
  },
  "options": [
    {
      "label": "NO",
      "actions": [
        {
          "do": "close_menu"
        }
      ]
    },
    {
      "label": "YES",
      "actions": [
        {
          "do": "set_var",
          "var": "unlocked",
          "value": 3
        },
        {
          "do": "set_var",
          "var": "chosen",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "best_time",
          "value": -1
        },
        {
          "do": "set_var",
          "var": "mode",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "cleared",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "shiny",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "shiny_runs",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "shiny_count",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "shinies",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "prize_1",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "prize_2",
          "value": 0
        },
        {
          "do": "set_var",
          "var": "prize_3",
          "value": 0
        },
        {
          "do": "save_game"
        },
        {
          "do": "close_menu"
        }
      ]
    }
  ],
  "on_cancel": [
    {
      "do": "close_menu"
    }
  ],
  "sounds": {
    "move": "sfx_select",
    "select": "sfx_confirm"
  }
}
