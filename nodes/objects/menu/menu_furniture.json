{
  "id": "menu_furniture",
  "kind": "object",
  "type": "menu",
  "name": "Furniture",
  "notes": "Furniture for your house (it appears there next time you go in). The fern plant and moss rug can also be earned from Pembrook and Tilly.",
  "font": "font_default",
  "title": "FURNITURE",
  "cursor": "icon_cursor",
  "box": {
    "x": 40,
    "y": 8,
    "w": 168,
    "h": 144,
    "paper": 3,
    "border": 12
  },
  "layout": {
    "x": 64,
    "y": 32,
    "spacing": 16,
    "title_y": 16
  },
  "options": [
    {
      "label": "LEAF LAMP    1200",
      "actions": [
        {
          "do": "if_var",
          "var": "fur_lamp",
          "op": "==",
          "value": 1,
          "then": [
            {
              "do": "play_sfx",
              "sfx": "sfx_nope"
            },
            {
              "do": "show_dialog",
              "dialog": "dlg_have_it"
            }
          ],
          "else": [
            {
              "do": "if_var",
              "var": "pips",
              "op": ">=",
              "value": 1200,
              "then": [
                {
                  "do": "add_var",
                  "var": "pips",
                  "value": -1200
                },
                {
                  "do": "set_var",
                  "var": "fur_lamp",
                  "value": 1
                },
                {
                  "do": "play_sfx",
                  "sfx": "sfx_coin"
                },
                {
                  "do": "show_dialog",
                  "dialog": "dlg_delivered"
                }
              ],
              "else": [
                {
                  "do": "play_sfx",
                  "sfx": "sfx_nope"
                },
                {
                  "do": "show_dialog",
                  "dialog": "dlg_broke"
                }
              ]
            }
          ]
        }
      ]
