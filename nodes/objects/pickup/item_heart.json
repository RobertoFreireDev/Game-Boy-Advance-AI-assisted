{
  "id": "item_heart",
  "kind": "object",
  "type": "pickup",
  "name": "Heart",
  "notes": "Gives back one heart (never more than 5). Knights drop one when defeated.",
  "children": ["body_heart"],
  "body": "body_heart",
  "logic": [
    {
      "behavior": "collectible",
      "params": {
        "var": "health",
        "amount": 1,
        "on_collect": [
          {
            "do": "if_var",
            "var": "health",
            "op": ">",
            "value": 5,
            "then": [
              {"do": "set_var", "var": "health", "value": 5}
            ]
          }
        ]
      }
    }
  ],
  "sounds": {"collect": "sfx_heart"}
}
