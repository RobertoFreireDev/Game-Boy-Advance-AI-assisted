{
  "id": "dlg_sage",
  "kind": "object",
  "type": "dialog",
  "name": "Sage's advice",
  "notes": "What the sage says: where the goal is, how to beat slimes, then he offers a coin (you only get it if you have none).",
  "children": ["icon_sage_face"],
  "font": "font_default",
  "box": {"x": 8, "y": 104, "w": 224, "h": 48, "paper": 3, "border": 2},
  "ticks_per_char": 2,
  "lines": [
             {
               "speaker": "SAGE",
               "portrait": "icon_sage_face",
               "text": "HELLO, HERO! THE FLAG IN THE EAST ENDS YOUR QUEST."
             },
             {
               "speaker": "SAGE",
               "portrait": "icon_sage_face",
               "text": "JUMP ON SLIMES TO BEAT THEM. MIND THE SPIKES!"
             },
             {"speaker": "SAGE", "portrait": "icon_sage_face", "text": "NEED A COIN FOR THE ROAD?"}
           ],
  "choices": [
               {
                 "label": "YES PLEASE",
                 "actions": [
                              {
                                "do": "if_var",
                                "var": "coins",
                                "op": "==",
                                "value": 0,
                                "then": [
                                          {"do": "add_var", "var": "coins", "value": 1},
                                          {"do": "play_sfx", "sfx": "sfx_coin"}
                                        ],
                                "else": [{"do": "play_sfx", "sfx": "sfx_select"}]
                              }
                            ]
               },
               {"label": "NO THANKS", "actions": [{"do": "play_sfx", "sfx": "sfx_select"}]}
             ],
  "on_end": []
}
