{
  "id": "enm_blob",
  "kind": "object",
  "type": "enemy",
  "name": "Blob",
  "notes": "Slow orange blob that wanders the meadow at random. Touching it costs a heart. Two sword hits defeat it and it always drops a gem.",
  "children": ["body_blob"],
  "body": "body_blob",
  "logic": [
    {
      "behavior": "wander",
      "params": {"speed": 0.4, "min_ticks": 40, "max_ticks": 100, "pause_ticks": 40}
    },
    {
      "behavior": "damage_on_touch",
      "params": {"amount": 1}
    },
    {
      "behavior": "health",
      "params": {
        "max": 2,
        "invincible_ticks": 16,
        "knockback": 1.5,
        "spikes": false,
        "on_death": [
          {"do": "spawn", "object": "item_gem"}
        ]
      }
    }
  ],
  "sounds": {"hurt": "sfx_enemy_hit", "die": "sfx_enemy_die"}
}
