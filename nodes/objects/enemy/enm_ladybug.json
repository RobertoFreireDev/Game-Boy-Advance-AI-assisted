{
  "id": "enm_ladybug",
  "kind": "object",
  "type": "enemy",
  "name": "Ladybug",
  "notes": "A Ladybug that comes out between 7:00 and 16:59. Swing the net (A, with the net in your hands) to catch it: it goes to your pockets (bug_ladybug) and you see a message. Harmless.",
  "body": "body_bug_ladybug",
  "logic": [
    {
      "behavior": "exists_when",
      "params": {
        "var": "hour",
        "min": 7,
        "max": 16
      }
    },
    {
      "behavior": "wander",
      "params": {
        "speed": 0.2,
        "min_ticks": 20,
        "max_ticks": 60,
        "pause_ticks": 90,
        "distance": 12
      }
    },
    {
      "behavior": "health",
      "params": {
        "max": 1,
        "invincible_ticks": 0,
        "knockback": 0,
        "spikes": false,
        "on_death": [
          {
            "do": "add_var",
            "var": "bug_ladybug",
            "value": 1
          },
          {
            "do": "play_sfx",
            "sfx": "sfx_catch"
          },
          {
            "do": "show_dialog",
            "dialog": "dlg_catch_ladybug"
          }
        ]
      }
    }
  ]
}
