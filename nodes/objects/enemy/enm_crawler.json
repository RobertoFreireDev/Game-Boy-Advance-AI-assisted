      }
    },
    {
      "behavior": "health",
      "params": {
        "max": 2,
        "invincible_ticks": 10,
        "knockback": 1.4,
        "spikes": false,
        "on_death": [
          {
            "do": "spawn",
            "object": "item_geo",
            "x": 0,
            "y": -10
          }
