{
  "id": "enm_lord",
  "kind": "object",
  "type": "enemy",
  "name": "Night Lord",
  "notes": "The final boss, arriving at 10:00 with his own music. Slow but huge: 2500 health, takes 2 hearts per touch and is barely pushed back. Defeating him wins the run (+100 bonus gold).",
  "body": "body_lord",
  "logic": [
    {"behavior": "swarm", "params": {"speed": 0.5, "leash": 0}},
    {"behavior": "damage_on_touch", "params": {"amount": 2}},
    {
      "behavior": "health",
      "params": {
        "max": 2500,
        "invincible_ticks": 6,
        "knockback": 0.2,
        "spikes": false,
        "on_death": [
          {"do": "shake_camera", "ticks": 40, "strength": 3},
          {"do": "stop_music"},
          {"do": "wait", "ticks": 60},
          {"do": "fade_out", "ticks": 40},
          {"do": "goto_scene", "scene": "scn_victory"}
        ]
      }
    }
  ],
  "sounds": {"die": "sfx_boss"},
  "children": ["body_lord"]
}
