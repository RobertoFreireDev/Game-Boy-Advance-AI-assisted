{
  "id": "enm_crab",
  "kind": "object",
  "type": "enemy",
  "name": "Shore Crab",
  "notes": "A Shore Crab that comes out at night between 18:00 and 6:59. Swing the net (A, with the net in your hands) to catch it: it goes to your pockets (bug_crab) and you see a message. Harmless.",
  "body": "body_bug_crab",
  "logic": [
    {
      "behavior": "exists_when",
      "params": {
        "var": "hour",
        "min": 18,
        "max": 6
      }
    },
    {
      "behavior": "wander",
      "params": {
        "speed": 0.5,
        "min_ticks": 20,
        "max_ticks": 50,
        "pause_ticks": 60,
        "distance": 40
      }
    },
    {
      "behavior": "health",
      "params": {
        "max": 1,
        "invincible_ticks": 0,
        "knockback": 0,
        "spikes": false,
        "on_death": [
          {
            "do": "add_var",
            "var": "bug_crab",
            "value": 1
          },
          {
            "do": "play_sfx",
            "sfx": "sfx_catch"
          },
          {
            "do": "show_dialog",
            "dialog": "dlg_catch_crab"
          }
        ]
      }
    }
  ]
}
