          {"do": "spawn", "object": "item_gem_big", "x": 0, "y": -6},
          {"do": "spawn", "object": "item_gem_big", "x": 0, "y": -6},
          {"do": "spawn", "object": "item_coin", "x": 6, "y": -4},
          {
            "do": "if_chance",
            "percent": 50,
            "then": [{"do": "spawn", "object": "item_meat", "x": -6, "y": -4}]
          }
        ]
      }
    }
