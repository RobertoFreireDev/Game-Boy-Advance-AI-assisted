{
  "id": "enm_bee",
  "kind": "object",
  "type": "enemy",
  "name": "Honeybee",
  "notes": "A Honeybee that comes out between 8:00 and 16:59. Swing the net (A, with the net in your hands) to catch it: it goes to your pockets (bug_bee) and you see a message. Harmless.",
  "body": "body_bug_bee",
  "logic": [
    {
      "behavior": "exists_when",
      "params": {
        "var": "hour",
        "min": 8,
        "max": 16
      }
    },
    {
      "behavior": "wander",
      "params": {
        "speed": 0.6,
        "min_ticks": 8,
        "max_ticks": 30,
        "pause_ticks": 30,
        "distance": 32
      }
    },
    {
      "behavior": "health",
      "params": {
        "max": 1,
        "invincible_ticks": 0,
        "knockback": 0,
        "spikes": false,
        "on_death": [
          {
            "do": "add_var",
            "var": "bug_bee",
            "value": 1
          },
          {
            "do": "play_sfx",
            "sfx": "sfx_catch"
          },
          {
            "do": "show_dialog",
            "dialog": "dlg_catch_bee"
          }
        ]
      }
    }
  ]
}
