{
  "id": "enm_zombie",
  "kind": "object",
  "type": "enemy",
  "name": "Zombie",
  "notes": "Slow and tough (3 bolts). Comes from minute 0:40, and in big rings after 6:40. Drops a gem, sometimes gold or a roast. After it hurts the hunter it is stunned for 3 seconds (stands still, harmless).",
  "body": "body_zombie",
  "logic": [
    {"behavior": "swarm", "params": {"leash": 220, "speed": 0.42}},
    {"behavior": "damage_on_touch", "params": {"amount": 1, "stun_ticks": 180}},
    {
      "behavior": "health",
      "params": {
        "max": 26,
        "invincible_ticks": 8,
        "knockback": 1.0,
        "spikes": false,
        "on_death": [
          {"do": "add_var", "var": "kills", "value": 1},
          {"do": "spawn", "object": "item_gem", "x": 0, "y": -6},
          {
            "do": "if_chance",
            "percent": 4,
            "then": [{"do": "spawn", "object": "item_coin", "x": 4, "y": -4}]
          },
          {
            "do": "if_chance",
            "percent": 2,
            "then": [{"do": "spawn", "object": "item_meat", "x": -4, "y": -4}]
          }
        ]
      }
    }
  ],
  "sounds": {"die": "sfx_enemy_die"},
  "children": ["body_zombie"]
}
