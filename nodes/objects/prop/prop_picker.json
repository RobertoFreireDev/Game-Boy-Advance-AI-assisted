{
  "id": "prop_picker",
  "kind": "object",
  "type": "prop",
  "name": "Monster picker",
  "notes": "Invisible: shows the chosen monster's big portrait, bobbing. Left / Right pick another (it slides and cries), through 18 entries in a loop: the 9 monsters of the classic mode, then the same 9 of the waves mode ('mode' 0 or 1; 'entry' = mode x 9 + monster, the slot of its best time). In the classic half only the first 'unlocked' monsters can be played (Furrbit, Emberpup and Splashell at first, then one more, in roster order, for the first win of each monster); the waves half is locked as a whole until all 9 monsters have won a classic run ('cleared' = 9). A locked entry shows as a dark silhouette (pal_locked) without its cry, the text under it says LOCKED and how to unlock it, and START on it buzzes (sfx_error). START on an open one resets the run's variables, draws the run's world at random (any of the 9), uses up the 3 items the last won run gave (prize_1-3: each adds its floor item's boost for this whole run, Swift Feather +10% SPEED, Power Gem +10% POWER, Aim Charm -5% MISS, Mist Orb +10% DODGE, Quick Hourglass -10% RECHARGE, on top of the home world and of anything picked up; used1-3 remember them for the words over the player, and prize_1-3 go back to 0, so they are never used twice), saves the pick and starts the classic run or the waves run. A shiny monster's portrait shimmers through the rainbow, on its classic and its waves entry alike. SELECT opens the 'clear saved progress' question.",
  "logic": [
    {
      "behavior": "species_select",
      "params": {
        "var": "chosen",
        "unlocked_var": "unlocked",
        "locked_var": "sel_locked",
        "locked_palette": "pal_locked",
        "locked_sound": "sfx_error",
        "browse": true,
        "button": "START",
        "slide": 40,
        "slide_ticks": 6,
        "bob": 2,
        "move_sound": "sfx_select",
        "on_pick": [
          {
            "do": "reset_vars"
          },
          {
            "do": "random_var",
            "var": "world",
            "min": 0,
            "max": 8
          },
          {
            "do": "set_var",
            "var": "used1",
            "from": "prize_1"
          },
          {
            "do": "if_var",
            "var": "prize_1",
            "op": "==",
            "value": 1,
            "then": [
              {
                "do": "add_var",
                "var": "boost_speed",
                "value": 1
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_1",
            "op": "==",
            "value": 2,
            "then": [
              {
                "do": "add_var",
                "var": "boost_power",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_1",
            "op": "==",
            "value": 3,
            "then": [
              {
                "do": "add_var",
                "var": "boost_aim",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_1",
            "op": "==",
            "value": 4,
            "then": [
              {
                "do": "add_var",
                "var": "boost_dodge",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_1",
            "op": "==",
            "value": 5,
            "then": [
              {
                "do": "add_var",
                "var": "boost_charge",
                "value": 10
              }
            ]
          },
          {
            "do": "set_var",
            "var": "prize_1",
            "value": 0
          },
          {
            "do": "set_var",
            "var": "used2",
            "from": "prize_2"
          },
          {
            "do": "if_var",
            "var": "prize_2",
            "op": "==",
            "value": 1,
            "then": [
              {
                "do": "add_var",
                "var": "boost_speed",
                "value": 1
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_2",
            "op": "==",
            "value": 2,
            "then": [
              {
                "do": "add_var",
                "var": "boost_power",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_2",
            "op": "==",
            "value": 3,
            "then": [
              {
                "do": "add_var",
                "var": "boost_aim",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_2",
            "op": "==",
            "value": 4,
            "then": [
              {
                "do": "add_var",
                "var": "boost_dodge",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_2",
            "op": "==",
            "value": 5,
            "then": [
              {
                "do": "add_var",
                "var": "boost_charge",
                "value": 10
              }
            ]
          },
          {
            "do": "set_var",
            "var": "prize_2",
            "value": 0
          },
          {
            "do": "set_var",
            "var": "used3",
            "from": "prize_3"
          },
          {
            "do": "if_var",
            "var": "prize_3",
            "op": "==",
            "value": 1,
            "then": [
              {
                "do": "add_var",
                "var": "boost_speed",
                "value": 1
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_3",
            "op": "==",
            "value": 2,
            "then": [
              {
                "do": "add_var",
                "var": "boost_power",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_3",
            "op": "==",
            "value": 3,
            "then": [
              {
                "do": "add_var",
                "var": "boost_aim",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_3",
            "op": "==",
            "value": 4,
            "then": [
              {
                "do": "add_var",
                "var": "boost_dodge",
                "value": 10
              }
            ]
          },
          {
            "do": "if_var",
            "var": "prize_3",
            "op": "==",
            "value": 5,
            "then": [
              {
                "do": "add_var",
                "var": "boost_charge",
                "value": 10
              }
            ]
          },
          {
            "do": "set_var",
            "var": "prize_3",
            "value": 0
          },
          {
            "do": "save_game"
          },
          {
            "do": "play_sfx",
            "sfx": "sfx_confirm"
          },
          {
            "do": "fade_out",
            "ticks": 20
          },
          {
            "do": "if_var",
            "var": "mode",
            "op": "==",
            "value": 1,
            "then": [
              {
                "do": "goto_scene",
                "scene": "scn_waves"
              }
            ],
            "else": [
              {
                "do": "goto_scene",
                "scene": "scn_run"
              }
            ]
          }
        ],
        "passes": 2,
        "pass_var": "mode",
        "entry_var": "entry",
        "pass_unlock_var": "cleared",
        "pass_unlock_at": 9,
        "shiny_var": "shiny"
      }
    },
    {
      "behavior": "button_actions",
      "params": {
        "button": "SELECT",
        "on_press": [
          {
            "do": "open_menu",
            "menu": "menu_clear_save"
          }
        ]
      }
    }
  ]
}
