{
  "id": "prop_shiny",
  "kind": "object",
  "type": "prop",
  "name": "Shiny portrait",
  "notes": "Invisible: shows the new shiny monster's portrait (new_shiny) bobbing and shimmering through the rainbow, and plays its cry. START goes back to the menu.",
  "logic": [
    {
      "behavior": "species_select",
      "params": {
        "var": "new_shiny",
        "shiny_var": "shiny",
        "browse": false,
        "button": "START",
        "bob": 2,
        "on_pick": [
          {
            "do": "play_sfx",
            "sfx": "sfx_confirm"
          },
          {
            "do": "fade_out",
            "ticks": 20
          },
          {
            "do": "goto_scene",
            "scene": "scn_menu"
          }
        ]
      }
    }
  ]
}
