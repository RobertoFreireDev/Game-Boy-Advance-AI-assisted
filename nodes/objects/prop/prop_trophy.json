{
  "id": "prop_trophy",
  "kind": "object",
  "type": "prop",
  "name": "Winner portrait",
  "notes": "Invisible: shows the winning monster's portrait bobbing and plays its cry; a shiny monster's portrait shimmers through the rainbow. START goes to the shiny screen when this win made a monster shiny (new_shiny is 0 or more), otherwise back to the menu.",
  "logic": [
    {
      "behavior": "species_select",
      "params": {
        "var": "chosen",
        "browse": false,
        "button": "START",
        "bob": 2,
        "on_pick": [
          {
            "do": "play_sfx",
            "sfx": "sfx_confirm"
          },
          {
            "do": "fade_out",
            "ticks": 20
          },
          {
            "do": "if_var",
            "var": "new_shiny",
            "op": ">=",
            "value": 0,
            "then": [
              {
                "do": "goto_scene",
                "scene": "scn_shiny"
              }
            ],
            "else": [
              {
                "do": "goto_scene",
                "scene": "scn_menu"
              }
            ]
          }
        ],
        "shiny_var": "shiny"
      }
    }
  ]
}
