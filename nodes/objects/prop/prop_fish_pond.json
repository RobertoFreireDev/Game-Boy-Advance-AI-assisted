{
  "id": "prop_fish_pond",
  "kind": "object",
  "type": "prop",
  "name": "Pond fish",
  "notes": "A fish in the pond: usually a carp; in the evening and at night (16:00-8:59) a rare koi may bite. Face it from the shore with the rod in your hands and press A to cast. Wait for the nibbles, then press A when it bites (you have 16 ticks).",
  "body": "body_shadow",
  "logic": [
    {
      "behavior": "wander",
      "params": {
        "speed": 0.3,
        "min_ticks": 30,
        "max_ticks": 90,
        "pause_ticks": 60,
        "distance": 14
      }
    },
    {
      "behavior": "fish_bite",
      "params": {
        "var": "rod_on",
        "window": 16,
        "on_catch": [
          {
            "do": "if_var",
            "var": "hour",
            "op": ">=",
            "value": 16,
            "then": [
              {
                "do": "if_chance",
                "percent": 30,
                "then": [
                  {
                    "do": "add_var",
                    "var": "fish_koi",
                    "value": 1
                  },
                  {
                    "do": "play_sfx",
                    "sfx": "sfx_catch"
                  },
                  {
                    "do": "show_dialog",
                    "dialog": "dlg_catch_koi"
                  }
                ],
                "else": [
                  {
                    "do": "add_var",
                    "var": "fish_carp",
                    "value": 1
                  },
                  {
                    "do": "play_sfx",
                    "sfx": "sfx_catch"
                  },
                  {
                    "do": "show_dialog",
                    "dialog": "dlg_catch_carp"
                  }
                ]
              }
            ],
            "else": [
              {
                "do": "if_var",
                "var": "hour",
                "op": "<",
                "value": 9,
                "then": [
                  {
                    "do": "if_chance",
                    "percent": 30,
                    "then": [
                      {
                        "do": "add_var",
                        "var": "fish_koi",
                        "value": 1
                      },
                      {
                        "do": "play_sfx",
                        "sfx": "sfx_catch"
                      },
                      {
                        "do": "show_dialog",
                        "dialog": "dlg_catch_koi"
                      }
                    ],
                    "else": [
                      {
                        "do": "add_var",
                        "var": "fish_carp",
                        "value": 1
                      },
                      {
                        "do": "play_sfx",
                        "sfx": "sfx_catch"
                      },
                      {
                        "do": "show_dialog",
                        "dialog": "dlg_catch_carp"
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "do": "if_chance",
                    "percent": 6,
                    "then": [
                      {
                        "do": "add_var",
                        "var": "fish_koi",
                        "value": 1
                      },
                      {
                        "do": "play_sfx",
                        "sfx": "sfx_catch"
                      },
                      {
                        "do": "show_dialog",
                        "dialog": "dlg_catch_koi"
                      }
                    ],
                    "else": [
                      {
                        "do": "add_var",
                        "var": "fish_carp",
                        "value": 1
                      },
                      {
                        "do": "play_sfx",
                        "sfx": "sfx_catch"
                      },
                      {
                        "do": "show_dialog",
                        "dialog": "dlg_catch_carp"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "on_escape": [
          {
            "do": "show_dialog",
            "dialog": "dlg_fish_escape"
          }
        ],
        "on_spook": [
          {
            "do": "show_dialog",
            "dialog": "dlg_fish_spook"
          }
        ]
      }
    }
  ],
  "sounds": {
    "jump": "sfx_cast",
    "attack": "sfx_plip",
    "hurt": "sfx_splash"
  }
}
