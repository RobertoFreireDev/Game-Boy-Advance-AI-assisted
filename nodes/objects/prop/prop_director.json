{
  "id": "prop_director",
  "kind": "object",
  "type": "prop",
  "name": "Night director",
  "notes": "Invisible (no body): runs the whole night. It keeps the clock, turns XP into levels (opening the level-up menu) and spawns the monster waves: bats from the start, zombies at 0:40, a ring of bats every 20 s from 1:40, skeleton packs at 2:50, ghosts at 4:40, zombie rings at 6:40, werewolves at 7:00 and the Night Lord at 10:00.",
  "logic": [
    {
      "behavior": "run_clock",
      "params": {"total_var": "time_total", "minutes_var": "time_min", "seconds_var": "time_sec"}
    },
    {
      "behavior": "level_up",
      "params": {
        "xp_var": "xp",
        "level_var": "level",
        "progress_var": "xp_pct",
        "first": 5,
        "growth": 7,
        "on_level_up": [{"do": "play_sfx", "sfx": "sfx_levelup"}, {"do": "open_menu", "menu": "menu_level_up"}]
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_bat",
        "clock_var": "time_total",
        "start": 0,
        "every": 50,
        "count": 2,
        "max_alive": 14,
        "formation": "scatter",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_zombie",
        "clock_var": "time_total",
        "start": 40,
        "every": 70,
        "count": 2,
        "max_alive": 14,
        "formation": "scatter",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_bat",
        "clock_var": "time_total",
        "start": 100,
        "every": 1200,
        "count": 14,
        "max_alive": 30,
        "formation": "ring",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_skeleton",
        "clock_var": "time_total",
        "start": 170,
        "every": 60,
        "count": 3,
        "max_alive": 16,
        "formation": "group",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_ghost",
        "clock_var": "time_total",
        "start": 280,
        "every": 50,
        "count": 2,
        "max_alive": 14,
        "formation": "scatter",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_zombie",
        "clock_var": "time_total",
        "start": 400,
        "every": 600,
        "count": 12,
        "max_alive": 30,
        "formation": "ring",
        "reserve": 26
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_wolf",
        "clock_var": "time_total",
        "start": 420,
        "every": 420,
        "count": 1,
        "max_alive": 4,
        "formation": "scatter",
        "reserve": 24
      }
    },
    {
      "behavior": "spawn_wave",
      "params": {
        "object": "enm_lord",
        "clock_var": "time_total",
        "start": 600,
        "every": 60,
        "count": 1,
        "max_alive": 1,
        "formation": "scatter",
        "once": true,
        "reserve": 0,
        "on_spawn": [
          {"do": "play_music", "music": "mus_boss"},
          {"do": "play_sfx", "sfx": "sfx_boss"},
          {"do": "shake_camera", "ticks": 40, "strength": 3}
        ]
      }
    }
  ]
}
