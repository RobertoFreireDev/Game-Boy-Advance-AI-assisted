                "var": "shell_1",
                "value": 0
              }
            ],
            "else": [
              {
                "do": "set_var",
                "var": "shell_1",
                "value": 1
              }
            ]
          },
          {
            "do": "if_chance",
            "percent": 60,
            "then": [
              {
                "do": "set_var",
                "var": "shell_2",
                "value": 0
              }
            ],
            "else": [
              {
                "do": "set_var",
                "var": "shell_2",
                "value": 1
              }
            ]
          },
          {
            "do": "if_chance",
            "percent": 60,
            "then": [
              {
                "do": "set_var",
                "var": "shell_3",
                "value": 0
              }
            ],
            "else": [
              {
                "do": "set_var",
                "var": "shell_3",
                "value": 1
              }
            ]
          },
          {
            "do": "if_chance",
            "percent": 60,
            "then": [
              {
                "do": "set_var",
                "var": "shell_4",
                "value": 0
              }
            ],
            "else": [
              {
                "do": "set_var",
                "var": "shell_4",
                "value": 1
              }
            ]
          },
          {
