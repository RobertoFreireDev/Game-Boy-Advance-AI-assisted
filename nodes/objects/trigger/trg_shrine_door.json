{
  "id": "trg_shrine_door",
  "kind": "object",
  "type": "trigger",
  "name": "Shrine entrance",
  "notes": "Invisible zone in the shrine doorway. With the sword: go inside. Without it: a message sends Kai to the elder.",
  "zone": {"w": 16, "h": 10},
  "logic": [
    {
      "behavior": "trigger_zone",
      "params": {
        "on_enter": [
          {
            "do": "if_var",
            "var": "has_sword",
            "op": "==",
            "value": 1,
            "then": [
              {"do": "play_sfx", "sfx": "sfx_confirm"},
              {"do": "fade_out", "ticks": 30},
              {"do": "goto_scene", "scene": "scn_shrine"}
            ],
            "else": [
              {"do": "show_dialog", "dialog": "dlg_need_sword"}
            ]
          }
        ]
      }
    }
  ]
}
