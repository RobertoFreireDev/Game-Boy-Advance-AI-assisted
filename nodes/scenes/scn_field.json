    {"id": "map", "object": "map_field"},
    {"id": "director", "object": "prop_director"},
    {"id": "pause", "object": "prop_pause"},
    {"id": "hunter", "object": "plr_hunter", "x": 384, "y": 392},
    {"id": "hud", "object": "hud_run"}
  ],
  "on_start": [
    {"do": "reset_vars"},
    {"do": "set_var", "var": "might", "from": "pu_might"},
    {"do": "set_var", "var": "haste", "from": "pu_haste"},
    {"do": "set_var", "var": "swift", "from": "pu_speed"},
    {"do": "set_var", "var": "magnet", "from": "pu_magnet"},
    {"do": "add_var", "var": "max_health", "from": "pu_health"},
    {"do": "add_var", "var": "health", "from": "pu_health"},
    {"do": "fade_in", "ticks": 20}
  ]
